# --- Database ---
DATABASE_URL="postgresql://azoniks@localhost:5432/hotel_booking?schema=public"

# --- NextAuth ---
# openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"
AUTH_URL="http://localhost:3000"

# --- App ---
APP_URL="http://localhost:3000"
APP_TIMEZONE="Europe/Moscow"
PAYMENT_TIMEOUT_MINUTES="15"

# --- Tinkoff payments ---
# В dev оставь TINKOFF_TEST_MODE=true и не заполняй ключи —
# оплата будет имитироваться через /payments/mock
TINKOFF_TEST_MODE="true"
TINKOFF_TERMINAL_KEY=""
TINKOFF_PASSWORD=""
TINKOFF_API_URL="https://securepay.tinkoff.ru/v2"
# секрет для подписи mock-confirm запросов (любая строка)
MOCK_PAYMENT_SECRET="dev-mock-secret"

# --- Email ---
# Если SMTP_HOST пуст — письма пишутся в консоль.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Booking <noreply@example.com>"

# --- Telegram ---
# Если пусто — уведомления отключены.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
