# /etc/systemd/system/booking.service
# systemctl daemon-reload
# systemctl enable --now booking
# journalctl -u booking -f      # просмотр логов

[Unit]
Description=Hotel Booking (Next.js)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=booking
Group=booking
WorkingDirectory=/srv/booking
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
EnvironmentFile=/srv/booking/.env

# Прямой запуск next вместо `npm run start` — npm иногда не пробрасывает
# SIGTERM детям, и старый процесс остаётся жить, занимая порт.
ExecStartPre=/usr/bin/npx prisma migrate deploy
ExecStart=/srv/booking/node_modules/.bin/next start -p 3000

KillMode=mixed
KillSignal=SIGTERM
Restart=on-failure
RestartSec=10s
TimeoutStopSec=20s

# Жёсткие лимиты
LimitNOFILE=65535
MemoryMax=1G

# Безопасность.
# ProtectSystem=full защищает /usr, /boot, /efi (этого достаточно).
# Не используем strict + ReadWritePaths: с ним Next.js не видит новые файлы
# в public/uploads/, созданные после старта процесса (нюансы mount namespace),
# и админ получает 404 на свежие загрузки.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
