# Скопируйте на сервере как /srv/booking/.env и заполните.
# chmod 600 .env  (чтобы видел только владелец)

# === БД ===
# Пользователь и пароль создаются на этапе setup (см. DEPLOY.md)
DATABASE_URL="postgresql://booking:CHANGEME_STRONG_PASSWORD@localhost:5432/hotel_booking?schema=public"

# === NextAuth ===
# Сгенерируйте: openssl rand -base64 48
AUTH_SECRET="REPLACE_WITH_long_random_string_at_least_32_chars"
AUTH_URL="https://booking.example.ru"

# === App ===
APP_URL="https://booking.example.ru"
APP_TIMEZONE="Europe/Moscow"
PAYMENT_TIMEOUT_MINUTES="15"

# === Tinkoff ===
# Все настройки Tinkoff теперь задаются через админку (/admin/settings).
# В .env оставляем только обязательные. TINKOFF_TEST_MODE используется как
# дефолт если в БД ничего не сохранено.
TINKOFF_TEST_MODE="false"
TINKOFF_TERMINAL_KEY=""
TINKOFF_PASSWORD=""
TINKOFF_API_URL="https://securepay.tinkoff.ru/v2"
# openssl rand -hex 32
MOCK_PAYMENT_SECRET="REPLACE_with_random_hex"

# === Email (SMTP) ===
# Если оставить SMTP_HOST пустым — письма пишутся в журнал systemd.
# Для prod подключите ваш SMTP (например, Yandex 360, Mail.ru для бизнеса, Sendpulse).
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT="465"
SMTP_USER="booking@yourdomain.ru"
SMTP_PASSWORD="app-password"
SMTP_FROM="Бронирование <booking@yourdomain.ru>"

# === Telegram / MAX ===
# Тоже настраиваются через админку. Оставляем пустыми — будут читаться из БД.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
