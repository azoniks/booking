# /etc/caddy/Caddyfile
# Замените booking.example.ru на ваш реальный домен.
# Caddy сам выпустит и продлит сертификат Let's Encrypt.

booking.example.ru {
    encode zstd gzip

    # Ограничим размер upload (медиа объектов).
    # 220 MB = верхняя планка под видео (в коде MAX_UPLOAD_MB.VIDEO = 200 MB,
    # +небольшой запас на multipart-обёртку).
    request_body {
        max_size 220MB
    }

    # Автономный виджет интерактивной карты для встраивания в Tilda.
    # Отдаём напрямую, чтобы обновление карты не зависело от сборки Next.js.
    handle_path /map-widget/* {
        root * /srv/booking/public/map-widget
        file_server
        header Cache-Control "public, max-age=3600"
        header Content-Security-Policy "frame-ancestors 'self' https://bazaklondaik.ru https://www.bazaklondaik.ru https://*.tilda.ws https://*.tilda.cc"
    }

    # Загруженные клиентами файлы (фото объектов и т.п.) отдаём напрямую
    # с диска. Next.js в production обслуживает только те файлы из public/,
    # которые были на момент `next build` — runtime-загрузки он игнорирует,
    # поэтому /uploads/* должен идти мимо него.
    handle_path /uploads/* {
        root * /srv/booking/public/uploads
        file_server {
            precompressed gzip
        }
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # Всё остальное — на Next.js
    handle {
        reverse_proxy localhost:3000 {
            transport http {
                read_timeout 300s
                write_timeout 300s
            }
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Безопасные заголовки
    @notMapWidget not path /map-widget/*
    header @notMapWidget X-Frame-Options "SAMEORIGIN"

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    log {
        output file /var/log/caddy/booking.log {
            roll_size 50mb
            roll_keep 7
        }
        format json
    }
}
